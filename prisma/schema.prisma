generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  PRO_PLUS
}

/// Matches the production enum created with the April 2026 comment schema.
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  banned        Boolean   @default(false)
  stripeCustomerId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  interests     Json      @default("[]")

  // MFA (TOTP) — see lib/services/mfa.ts
  mfaEnabled    Boolean   @default(false)
  // Encrypted TOTP secret; null until the user enrols. Encrypted with
  // AES-GCM via NEXTAUTH_SECRET in lib/services/mfa.ts.
  mfaSecret     String?
  // Hashed single-use backup codes (bcrypt). Populated at enrol time.
  mfaBackupCodes String[]  @default([])
  mfaVerifiedAt DateTime?
  /// The reader's choice on the dashboard: record which articles they read, how far and how long.
  trackReading  Boolean   @default(true)
  /// Articles per week the reader aims for (1-7); reaching it extends the streak.
  weeklyGoal    Int       @default(3)
  /// Opt-in: an email when someone replies to one of the reader's comments.
  notifyReplies Boolean   @default(false)
  /// Opt-in: a Sunday email with unfinished articles and the week's goal.
  weeklyReminder Boolean  @default(false)
  lastReminderAt DateTime?
  /// When the reader last opened the dashboard home, for "new since your last visit".
  dashboardSeenAt DateTime?

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  savedPosts    SavedPost[]
  collections   Collection[]
  ebookPurchases EbookPurchase[]
  newsletterSubscriber NewsletterSubscriber?
  contactSubmissions   ContactSubmission[]
  readingHistory ReadingHistory[]
  readingDays    ReadingDay[]
  avatar         UserAvatar?
  reactions      PostReaction[]
  comments       PostComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postSlug  String
  createdAt DateTime @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections SavedPostCollection[]

  @@unique([userId, postSlug])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// A key from FOLDER_COLORS in lib/reader/rules.ts.
  color     String   @default("teal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPosts SavedPostCollection[]

  @@unique([userId, name])
}

model SavedPostCollection {
  id           String @id @default(cuid())
  savedPostId  String
  collectionId String

  savedPost  SavedPost  @relation(fields: [savedPostId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([savedPostId, collectionId])
}

model Ebook {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  coverImageUrl   String?
  pdfUrl          String
  price           Int
  freeWithPro     Boolean  @default(false)
  stripePriceId   String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchases EbookPurchase[]
}

model EbookPurchase {
  id                    String   @id @default(cuid())
  userId                String
  ebookId               String
  stripePaymentIntentId String?
  createdAt             DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
}

/// A picture the reader uploaded, re-encoded as a 256 px WebP. User.image points at /api/avatar/<id>.
model UserAvatar {
  userId        String   @id
  data          Bytes
  /// The Google or GitHub picture in use before the upload, put back when the reader removes theirs.
  previousImage String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Seconds of reading per reader per UTC day: the activity calendar on the dashboard.
model ReadingDay {
  id      String   @id @default(cuid())
  userId  String
  day     DateTime @db.Date
  seconds Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  userId           String?  @unique
  confirmed        Boolean  @default(false)
  confirmToken     String?  @unique
  unsubscribeToken String   @unique
  preferences      Json     @default("{}")
  /// When the double opt-in link was pressed: the proof of consent (GDPR Art. 7(1)).
  confirmedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Course waitlist: separate from the newsletter on purpose, so a person who
/// only asked to hear when the course opens never receives campaigns. Double
/// opt-in like the newsletter; unsubscribing deletes the row.
model CourseWaitlist {
  id               String   @id @default(cuid())
  email            String   @unique
  confirmed        Boolean  @default(false)
  confirmToken     String?  @unique
  unsubscribeToken String   @unique
  level            String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NewsletterCampaign {
  id             String    @id @default(cuid())
  subject        String
  htmlBody       String    @db.Text
  preheader      String?
  note           String?   @db.Text
  postSlug       String?
  /// SENDING | SENT | PARTIAL | FAILED. In production the column is still the
  /// Postgres enum "CampaignStatus" from an earlier schema; every value written
  /// here must exist there (PARTIAL was added by hand on 2026-11-02).
  status         String    @default("SENT")
  recipientCount Int       @default(0)
  failedCount    Int       @default(0)
  sentAt         DateTime?
  sentCount      Int       @default(0)
  openCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  // The production table has this NOT NULL column; without it here every
  // insert failed and no letter could be sent.
  updatedAt      DateTime  @default(now()) @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// One JSON document per settings section, edited from the admin portal.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// The single administrator account. Takes over from the environment
/// credentials once the operator sets a password of their own.
model AdminAccount {
  id                String    @id @default("admin")
  username          String
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  mfaSecret         String?
  mfaPendingSecret  String?
  mfaBackupCodes    String[]  @default([])
  mfaEnabledAt      DateTime?
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// What the administrator did in the portal, and every login attempt.
model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Daily totals from the site's own anonymous counting. One row per day, metric
/// and key; nothing in here identifies or connects visitors.
model AnalyticsCounter {
  day    DateTime @db.Date
  metric String
  key    String   @default("")
  value  Int      @default(0)

  @@id([day, metric, key])
  @@index([metric, day])
}

/// Daily aggregates copied from Google Search Console by scripts/gsc-sync.mjs.
model SearchStat {
  day         DateTime @db.Date
  kind        String
  key         String   @default("")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  position    Float    @default(0)

  @@id([day, kind, key])
  @@index([kind, day])
}

model PostView {
  id        String   @id @default(cuid())
  postSlug  String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([postSlug])
}

model ReadingHistory {
  id            String    @id @default(cuid())
  userId        String
  postSlug      String
  readAt        DateTime  @default(now())
  completedAt   DateTime?
  /// The furthest point reached, 0-100. Only ever grows.
  scrollPercent Int       @default(0)
  /// Where the reader was last time, 0-100, for "continue where you left off".
  lastPercent   Int       @default(0)
  /// Time spent on the article while the page was visible, in seconds.
  secondsRead   Int       @default(0)
  /// Present in production from an earlier schema; not written by this code.
  referer       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postSlug])
  @@index([userId, readAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  userId    String?
  ipHash    String?
  postSlug  String
  type      String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postSlug, type])
  @@unique([ipHash, postSlug, type])
  @@index([postSlug])
}

model EmailSequenceStatus {
  id            String   @id @default(cuid())
  subscriberId  String
  sequenceName  String
  lastStepSent  Int      @default(0)
  nextSendAt    DateTime
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([subscriberId, sequenceName])
  @@index([nextSendAt, completed])
}

/// A reader's comment under an article. The table already existed in
/// production (empty, from the April 2026 schema); this model mirrors it
/// column for column, so no migration was needed. A reader's first comment
/// waits for approval; once one is approved, later ones publish at once.
model PostComment {
  id            String        @id @default(cuid())
  postSlug      String
  userId        String
  parentId      String?
  body          String
  status        CommentStatus @default(PENDING)
  reportedCount Int           @default(0)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies PostComment[] @relation("CommentReplies")

  @@index([postSlug, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
