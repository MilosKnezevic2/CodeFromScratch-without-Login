# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blogcms?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Server-only write token (legacy; optional). Prefer SANITY_API_READ_TOKEN for draft-mode preview reads.
SANITY_API_TOKEN=""
# Server-only viewer-scope token used by the draft-mode route so Sanity
# Presentation can preview unpublished content. Create in the Sanity
# project dashboard → API → Tokens → Viewer role.
SANITY_API_READ_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""

# Resend
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Plausible analytics (optional; script loads only when set, e.g. "codefromscratch.org")
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Google Search Console ownership proof via HTML meta tag (alternative to
# the DNS TXT method). In GSC choose "URL prefix" property → "HTML tag"
# verification → copy ONLY the content="..." value here, then redeploy
# and click Verify. Empty = no tag rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Vercel cron auth (optional but recommended in production). When set, the
# daily /api/keepalive cron must present it as a bearer token. Set the same
# value in Vercel → Project → Settings → Environment Variables; Vercel
# attaches it to cron requests automatically.
CRON_SECRET=""

# Shared secret for the Sanity → /api/revalidate webhook (required for
# instant cache refresh on publish; the endpoint rejects everything until
# it is set). Generate with `openssl rand -hex 32`, put the same value in
# the Sanity webhook as a custom header:  x-revalidate-secret: <value>
SANITY_REVALIDATE_SECRET=""

# Admin portal credentials (env-only; no DB row).
CFS_ADMIN_USERNAME=""
CFS_ADMIN_PASSWORD=""
# Optional: when set, admin login also requires a 6-digit TOTP code.
# Generate once with:  node -e "import('otplib').then(m => console.log(m.generateSecret()))"
# Paste the printed base32 string into your authenticator app (manual entry)
# AND into the value below. Leave empty to disable admin MFA.
CFS_ADMIN_MFA_SECRET=""

# Sentry (error tracking — optional; leave empty until Sentry project exists)
# NEXT_PUBLIC_SENTRY_DSN ships to the browser; SENTRY_DSN is server-side only.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Source map upload (CI / production only). Obtain from Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
